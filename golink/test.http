@base_url = http://127.0.0.1:2008

### 1. Rota Teste
GET {{base_url}}/
Content-Type: application/json


### 2. Criar User
POST {{base_url}}/user 
Content-Type: application/json

{
  "email": "donamaia@gmail.com",
  "password": "Senha123",
  "repeat_password": "Senha123"
}


### 3. Login user
# @name login
POST {{base_url}}/user/login 
Content-Type: application/json

{
  "email": "donamaia@gmail.com",
  "password": "Senha123"
}


### 4. Create Link
POST {{base_url}}/user/auth/link
Cookie: {{login.response.headers.Set-Cookie}}

{
  "title": "dona",
  "url": "https://hortelatricot.com.br/?srsltid=AU7gw4UyqiNMxGMGBHY7M8oZkx8k7JE2m5cVmsdUH0JHIF_pdkZBO7JJ"
}
