@base_url = http://127.0.0.1:2008

### 1. Rota Teste
GET {{base_url}}/
Content-Type: application/json


### 2. Criar User
POST {{base_url}}/user 
Content-Type: application/json

{
  "email": "dante@vidaloka.com",
  "password": "Senha123",
  "repeat_password": "Senha123"
}


### 3. Login user
# @name login
POST {{base_url}}/user/login 
Content-Type: application/json

{
  "email": "dante@vidaloka.com",
  "password": "Senha123"
}


### 4. Create Link
POST {{base_url}}/user/auth/link
Cookie: {{login.response.headers.Set-Cookie}}

{
  "title": "movee",
  "url": "https://www.movement.com.br/"
}

### 5. Update Link
PUT {{base_url}}/user/auth/link/da50f893-719b-4bef-8202-789d37cff849
Cookie: {{login.response.headers.Set-Cookie}}

{
  "title": "video",
  "url": "https://www.comprimirvideo.com.br/"
}